{
  "name": "omni-data-editor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r run build",
    "build:examples": "vite build examples",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "check:packages": "node scripts/check-packages.mjs",
    "test:consumer": "node scripts/consumer.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:build": "vitepress build docs",
    "docs:api": "typedoc",
    "changeset": "changeset",
    "verify": "node scripts/verify.mjs",
    "check:artifacts": "node scripts/validate-artifacts.mjs",
    "check:bundles": "node scripts/bundle-sizes.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "dev": "vite examples --host 127.0.0.1",
    "release:draft": "node scripts/draft-release.mjs",
    "release:publish-artifacts": "node scripts/publish-release-artifacts.mjs",
    "version:packages": "changeset version",
    "package:pages": "node scripts/package-pages-site.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^24",
    "@types/jquery": "4.0.1",
    "@types/tabulator-tables": "6.3.6",
    "@vitest/browser-playwright": "5.0.5",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "tsdown": "0.23.1",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "webpack": "5.112.0",
    "webpack-cli": "7.2.3",
    "next": "16.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.10",
    "vitepress": "1.6.4",
    "typedoc": "0.28.20",
    "datatables.net": "3.1.4",
    "datatables.net-select": "4.1.1",
    "tabulator-tables": "6.7.0",
    "jquery": "4.0.0",
    "@omnidataeditor/core": "workspace:*",
    "@omnidataeditor/dom": "workspace:*",
    "@omnidataeditor/editor": "workspace:*",
    "@omnidataeditor/field-async-select": "workspace:*",
    "@omnidataeditor/host-datatables": "workspace:*",
    "@omnidataeditor/host-tabulator": "workspace:*",
    "@omnidataeditor/presentation-dialog": "workspace:*",
    "@omnidataeditor/presentation-inline": "workspace:*",
    "@omnidataeditor/theme-default": "workspace:*",
    "cross-spawn": "7.0.6",
    "semver": "7.8.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bensitu/omni-data-editor.git"
  }
}
